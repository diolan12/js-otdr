{
  "name": "@diolan12/js-otdr",
  "version": "1.0.1",
  "description": "Zero-dependency Telcordia SR-4731 SOR file parser",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
